<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title ? locals.title + ' — BORO' : 'BORO — Community Space Sharing Platform' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: { DEFAULT: '#333434', hover: '#1e1f1f', container: '#4a4a4a' },
            secondary: { DEFAULT: '#5d5e5f', container: '#e0dfdf' },
            surface: { DEFAULT: '#f7f9ff', card: '#ffffff', tint: '#edf4ff', container: '#e3efff', high: '#d8eaff', dim: '#c7dcf4' },
            inverse: { DEFAULT: '#1e3244', ink: '#e8f2ff' },
            ink: { DEFAULT: '#071d2e', secondary: '#444748', muted: '#52585c' },
            line: { DEFAULT: '#c4c7c7', subtle: '#e8ecf2' },
            status: {
              success: '#3a6b35', 'success-tint': '#e6f0e5',
              info: '#3b6b93', 'info-tint': '#e3efff',
              warning: '#8a6d2a', 'warning-tint': '#f5f0dc',
              danger: '#a13225', 'danger-tint': '#fde8e5'
            },
            error: { DEFAULT: '#ba1a1a', container: '#ffdad6' }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif']
          }
        }
      }
    };
  </script>
</head>
<body class="bg-surface text-ink min-h-screen flex flex-col justify-center items-center p-4 sm:p-6 font-sans">

  <!-- Accessible Skip Link -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded-md focus:ring-2 focus:ring-[#edf4ff]">
    Skip to main content
  </a>

  <!-- Flash Toast Notifications -->
  <%- include('partials/Toast') %>

  <!-- Main Content Centered Container (No navbar, No sidebar) -->
  <main id="main-content" class="w-full max-w-md my-auto">
    <%- body %>
  </main>

  <script src="/js/app.js"></script>
</body>
</html>

