<!-- User Navigation Sidebar -->
<aside class="w-64 bg-surface-card border-r border-line flex flex-col justify-between py-6 px-4 shrink-0">
  <div class="space-y-6">
    <!-- User Reliability Card -->
    <% if (locals.currentUser) { %>
      <div class="bg-surface-tint border border-line rounded-lg p-3.5">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-ink-secondary">Reliability Status</span>
          <span class="w-2.5 h-2.5 rounded-full bg-status-success"></span>
        </div>
        <div class="flex items-baseline justify-between">
          <div>
            <div class="text-sm font-bold text-ink">Tier <%= locals.currentUser.tier || 1 %> Community</div>
            <div class="text-[11px] text-ink-muted">Advisory rating</div>
          </div>
          <div class="text-xl font-bold text-ink"><%= locals.currentUser.score || 100 %> <span class="text-xs text-ink-muted font-normal">/ 120</span></div>
        </div>
      </div>
    <% } %>

    <!-- Navigation Links -->
    <nav class="space-y-1">
      <a href="/search" class="flex items-center space-x-3 px-3 py-2.5 rounded-md text-sm font-medium transition-colors <%= (locals.activeRoute === 'search') ? 'bg-primary text-white' : 'text-ink-secondary hover:bg-surface-tint hover:text-ink' %>">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        <span>Discover Spaces</span>
      </a>

      <a href="/my-bookings" class="flex items-center justify-between px-3 py-2.5 rounded-md text-sm font-medium transition-colors <%= (locals.activeRoute === 'my-bookings') ? 'bg-primary text-white' : 'text-ink-secondary hover:bg-surface-tint hover:text-ink' %>">
        <div class="flex items-center space-x-3">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          <span>My Bookings</span>
        </div>
        <% if (locals.currentUser && locals.currentUser.active_bookings > 0) { %>
          <span class="text-xs px-2 py-0.5 rounded-full font-semibold <%= (locals.activeRoute === 'my-bookings') ? 'bg-white/20 text-white' : 'bg-surface-container text-ink' %>"><%= locals.currentUser.active_bookings %></span>
        <% } %>
      </a>

      <a href="/my-score" class="flex items-center justify-between px-3 py-2.5 rounded-md text-sm font-medium transition-colors <%= (locals.activeRoute === 'my-score') ? 'bg-primary text-white' : 'text-ink-secondary hover:bg-surface-tint hover:text-ink' %>">
        <div class="flex items-center space-x-3">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          <span>My Score</span>
        </div>
        <span class="text-xs px-2 py-0.5 rounded-full font-semibold <%= (locals.activeRoute === 'my-score') ? 'bg-white/20 text-white' : 'bg-surface-container text-ink' %>"><%= locals.currentUser ? locals.currentUser.score : 100 %></span>
      </a>

      <a href="/history" class="flex items-center space-x-3 px-3 py-2.5 rounded-md text-sm font-medium transition-colors <%= (locals.activeRoute === 'history') ? 'bg-primary text-white' : 'text-ink-secondary hover:bg-surface-tint hover:text-ink' %>">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>History</span>
      </a>

      <a href="/notifications" class="flex items-center justify-between px-3 py-2.5 rounded-md text-sm font-medium transition-colors <%= (locals.activeRoute === 'notifications') ? 'bg-primary text-white' : 'text-ink-secondary hover:bg-surface-tint hover:text-ink' %>">
        <div class="flex items-center space-x-3">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
          <span>Notifications</span>
        </div>
        <% if (locals.unreadNotificationsCount && locals.unreadNotificationsCount > 0) { %>
          <span class="text-xs px-2 py-0.5 rounded-full font-semibold bg-status-danger text-white"><%= locals.unreadNotificationsCount %></span>
        <% } %>
      </a>

      <a href="/profile" class="flex items-center space-x-3 px-3 py-2.5 rounded-md text-sm font-medium transition-colors <%= (locals.activeRoute === 'profile') ? 'bg-primary text-white' : 'text-ink-secondary hover:bg-surface-tint hover:text-ink' %>">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
        <span>Verification &amp; Profile</span>
      </a>
    </nav>
  </div>

  <!-- Bottom Footer Info -->
  <div class="pt-6 border-t border-line text-xs text-ink-muted">
    <div class="flex items-center justify-between mb-1">
      <span>BORO Platform</span>
      <span class="font-mono">v1.0-demo</span>
    </div>
    <div class="text-[11px] text-ink-muted">All decisions made by human community wardens.</div>
  </div>
</aside>
