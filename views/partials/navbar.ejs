<nav class="bg-surface-card border-b border-line px-4 lg:px-8 py-3 sticky top-0 z-30 flex items-center justify-between">
  <!-- Left: Logo & Search -->
  <div class="flex items-center space-x-6 flex-1 max-w-2xl">
    <a href="/search" class="flex items-center space-x-2 text-primary font-bold text-xl tracking-tight focus:ring-2 focus:ring-primary rounded-md p-1">
      <div class="w-8 h-8 rounded-lg bg-primary text-white flex items-center justify-center text-sm font-semibold">B</div>
      <span>BORO</span>
    </a>

    <!-- Quick Search Bar (desktop) -->
    <form action="/search" method="GET" class="hidden md:flex items-center flex-1 relative">
      <input
        type="text"
        name="search"
        placeholder="Search spaces, locations, purposes..."
        class="w-full bg-surface-tint border border-line rounded-lg pl-9 pr-4 py-2 text-sm text-ink placeholder-ink-muted focus:outline-none focus:ring-2 focus:ring-primary"
      />
      <svg class="w-4 h-4 text-ink-muted absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </form>
  </div>

  <!-- Right: Notifications & User Avatar Dropdown -->
  <div class="flex items-center space-x-3">
    <!-- Notification Bell -->
    <a href="/notifications" class="relative p-2 rounded-lg text-ink-secondary hover:bg-surface-tint hover:text-ink focus:ring-2 focus:ring-primary" title="Notifications" aria-label="Notifications">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
      </svg>
      <% if (locals.unreadNotificationsCount && locals.unreadNotificationsCount > 0) { %>
        <span class="absolute top-1 right-1 w-2.5 h-2.5 rounded-full bg-status-danger"></span>
      <% } %>
    </a>

    <!-- User Profile Dropdown Button -->
    <% if (locals.currentUser) { %>
      <div class="relative" id="user-menu-container">
        <button
          type="button"
          id="user-menu-button"
          aria-expanded="false"
          aria-haspopup="true"
          class="flex items-center space-x-2 pl-2 focus:ring-2 focus:ring-primary rounded-lg p-1 hover:bg-surface-tint transition"
        >
          <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-xs font-semibold">
            <%= locals.currentUser.initials || 'ME' %>
          </div>
          <div class="hidden md:block text-left">
            <div class="text-xs font-semibold text-ink leading-tight"><%= locals.currentUser.name %></div>
            <div class="text-[10px] text-ink-muted capitalize leading-tight"><%= locals.currentUser.role %></div>
          </div>
          <svg class="w-4 h-4 text-ink-muted hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="user-dropdown-menu"
          class="hidden absolute right-0 mt-2 w-56 bg-surface-card border border-line rounded-xl shadow-lg py-2 z-50 text-xs"
        >
          <div class="px-3.5 py-2 border-b border-line">
            <div class="font-bold text-ink"><%= locals.currentUser.name %></div>
            <div class="text-ink-muted text-[11px] truncate"><%= locals.currentUser.email %></div>
            <span class="inline-block mt-1 text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded bg-surface-tint border border-line text-ink">
              <%= locals.currentUser.role %>
            </span>
          </div>

          <div class="py-1">
            <a href="/profile" class="flex items-center gap-2 px-3.5 py-2 text-ink hover:bg-surface-tint transition">
              <svg class="w-4 h-4 text-ink-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
              <span>My Profile & Verification</span>
            </a>
            <a href="/login" class="flex items-center gap-2 px-3.5 py-2 text-ink hover:bg-surface-tint transition">
              <svg class="w-4 h-4 text-ink-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
              <span>Switch demo account</span>
            </a>
          </div>

          <div class="pt-1 border-t border-line">
            <form action="/logout" method="POST" class="w-full m-0 p-0">
              <!-- BACKEND: wire a real CSRF check -->
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
              <button type="submit" class="w-full text-left flex items-center gap-2 px-3.5 py-2 text-status-danger hover:bg-status-danger/10 transition font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                <span>Sign out</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="flex items-center space-x-2">
        <a href="/login" class="btn btn-ghost text-xs py-1.5 px-3">Sign in</a>
        <a href="/signup" class="btn btn-primary text-xs py-1.5 px-3">Sign up</a>
      </div>
    <% } %>

    <!-- Mobile Drawer Hamburger -->
    <button id="mobile-menu-toggle" type="button" class="lg:hidden p-2 rounded-lg text-ink-secondary hover:bg-surface-tint focus:ring-2 focus:ring-primary" aria-label="Toggle navigation">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</nav>
