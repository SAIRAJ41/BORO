<%
  const spType = locals.spaceType || 'community_hall';
  const mode = locals.mode || 'checkin'; // 'checkin' or 'return'
  const isOutdoor = spType === 'community_ground' || spType === 'school_playground';

  let checklistItems = [];
  if (spType === 'community_ground' || spType === 'school_playground') {
    checklistItems = [
      { id: 'item_litter', label: 'Outfield & sideline litter cleared into bins' },
      { id: 'item_posts', label: 'Goal posts, nets & boundary markers intact' },
      { id: 'item_surface', label: 'Ground surface and turf undamaged (no ruts)' },
      { id: 'item_gate', label: 'Main entry gates and security padlock locked' }
    ];
  } else if (spType === 'storeroom') {
    checklistItems = [
      { id: 'item_arranged', label: 'Community items neatly arranged along racks' },
      { id: 'item_shelves', label: 'Heavy-duty steel shelves and bins intact' },
      { id: 'item_lock', label: 'Heavy deadbolt & door padlock verified locked' }
    ];
  } else {
    // community_hall or small_room
    checklistItems = [
      { id: 'item_clean', label: 'Cleanliness verified (floors swept, surfaces sanitized)' },
      { id: 'item_furniture', label: 'Furniture & seating returned to baseline layout' },
      { id: 'item_lights', label: 'Lighting, switchboards & A/V returned undamaged' },
      { id: 'item_doors', label: 'Emergency exits clear and facility secured' }
    ];
  }
%>
<div class="bg-surface-tint border border-line rounded-xl p-4 md:p-5 space-y-4">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-2">
      <div class="w-6 h-6 rounded-full bg-primary text-white flex items-center justify-center text-xs">✓</div>
      <h4 class="text-xs font-bold text-ink uppercase tracking-wider">
        <%= mode === 'checkin' ? 'Pre-Entry Handover Baseline' : 'Post-Session Return Inspection' %>
      </h4>
    </div>
    <span class="text-[11px] font-semibold text-ink-secondary capitalize"><%= formatSpaceType(spType) %> Checklist</span>
  </div>

  <% if (isOutdoor) { %>
    <div class="p-2.5 bg-surface-container rounded-lg text-xs text-ink-secondary flex items-center space-x-2">
      <span>⛅</span>
      <span>Outdoor Space: Weather dependent, free reschedule permitted.</span>
    </div>
  <% } %>

  <!-- Dynamic Checklist -->
  <div class="space-y-2.5">
    <% checklistItems.forEach(function(item) { %>
      <label class="flex items-start space-x-3 text-xs text-ink cursor-pointer bg-surface-card p-2.5 rounded-lg border border-line hover:border-line-subtle transition-colors">
        <input
          type="checkbox"
          name="checklist[]"
          value="<%= item.id %>"
          checked
          class="w-4 h-4 mt-0.5 rounded border-line text-primary focus:ring-primary"
        />
        <span class="font-medium flex-1"><%= item.label %></span>
      </label>
    <% }); %>
  </div>

  <!-- Condition Notes -->
  <div>
    <label class="block text-xs font-semibold text-ink mb-1">
      Custodian Condition Notes
    </label>
    <textarea
      name="condition_notes"
      rows="2"
      placeholder="Optional observations on room state, furniture alignment, or meter readings..."
      class="w-full bg-surface-card border border-line rounded-lg p-2.5 text-xs text-ink placeholder-ink-muted focus:outline-none focus:ring-2 focus:ring-primary"
    ><%= locals.notes || '' %></textarea>
  </div>
</div>
