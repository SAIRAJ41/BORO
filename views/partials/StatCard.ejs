<%#
  StatCard Partial
  Props:
    title: string ('Total Earnings', 'Active Bookings')
    value: string | number ('₹18,400', '12')
    subtext: string ('+12% from last month')
    icon: svg string or name
    variant: 'default' | 'success' | 'warning' | 'danger'
%>
<% const cardVariant = typeof variant !== 'undefined' ? variant : 'default'; %>

<div class="card p-5 bg-surface border border-line flex flex-col justify-between">
  <div class="flex items-center justify-between">
    <span class="text-xs font-medium uppercase tracking-wider text-ink-muted"><%= title %></span>
    <% if (typeof icon !== 'undefined' && icon) { %>
      <div class="w-8 h-8 rounded-lg bg-surface-tint flex items-center justify-center text-ink-muted">
        <%- icon %>
      </div>
    <% } %>
  </div>
  <div class="mt-3">
    <div class="text-2xl font-bold text-ink"><%= value %></div>
    <% if (typeof subtext !== 'undefined' && subtext) { %>
      <p class="mt-1 text-xs text-ink-muted"><%= subtext %></p>
    <% } %>
  </div>
</div>
