<%#
  Table Partial
  Props:
    headers: ['ID', 'Space', 'Date', 'Status', 'Actions']
    caption: optional table description for a11y
%>
<div class="overflow-x-auto rounded-2xl border border-line bg-surface">
  <table class="w-full text-left text-sm text-ink divide-y divide-line">
    <% if (typeof caption !== 'undefined' && caption) { %>
      <caption class="sr-only"><%= caption %></caption>
    <% } %>
    <thead class="bg-surface-tint text-xs font-semibold text-ink-muted uppercase tracking-wider">
      <tr>
        <% (headers || []).forEach(header => { %>
          <th scope="col" class="px-5 py-3.5"><%= header %></th>
        <% }); %>
      </tr>
    </thead>
    <tbody class="divide-y divide-line">
      <%- bodyContent || '' %>
    </tbody>
  </table>
</div>
