<!-- Owner Navigation Sidebar -->
<aside class="w-64 bg-surface-card border-r border-line flex flex-col justify-between py-6 px-4 shrink-0">
  <div class="space-y-6">
    <!-- Owner Verification Status Banner -->
    <% if (locals.ownerVerified === false || (locals.currentUser && locals.currentUser.status === 'pending')) { %>
      <div class="bg-status-warning-tint border border-status-warning/40 rounded-lg p-3">
        <div class="flex items-center space-x-2 text-status-warning mb-1">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          <span class="text-xs font-bold uppercase tracking-wider">Pending Verification</span>
        </div>
        <p class="text-[11px] text-ink-secondary">Admin review in progress. Space listings remain disabled until approval.</p>
      </div>
    <% } else { %>
      <div class="bg-surface-tint border border-line rounded-lg p-3">
        <div class="flex items-center justify-between mb-1">
          <span class="text-xs font-semibold text-ink-secondary">Owner Accreditation</span>
          <span class="w-2 h-2 rounded-full bg-status-success"></span>
        </div>
        <div class="text-xs font-bold text-ink">Verified Space Partner</div>
        <div class="text-[11px] text-ink-muted">Licensed community custodian</div>
      </div>
    <% } %>

    <!-- Navigation Links -->
    <nav class="space-y-1">
      <a href="/owner/requests" class="flex items-center justify-between px-3 py-2.5 rounded-md text-sm font-medium transition-colors <%= (locals.activeRoute === 'owner-requests') ? 'bg-primary text-white' : 'text-ink-secondary hover:bg-surface-tint hover:text-ink' %>">
        <div class="flex items-center space-x-3">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
          <span>Requests</span>
        </div>
        <span class="text-xs px-2 py-0.5 rounded-full font-semibold <%= (locals.activeRoute === 'owner-requests') ? 'bg-white/20 text-white' : 'bg-surface-container text-ink' %>"><%= (locals.pendingRequestsCount != null) ? locals.pendingRequestsCount : 4 %></span>
      </a>

      <a href="/owner/my-spaces" class="flex items-center space-x-3 px-3 py-2.5 rounded-md text-sm font-medium transition-colors <%= (locals.activeRoute === 'owner-spaces') ? 'bg-primary text-white' : 'text-ink-secondary hover:bg-surface-tint hover:text-ink' %>">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
        <span>My Spaces</span>
      </a>

      <a href="/owner/calendar" class="flex items-center space-x-3 px-3 py-2.5 rounded-md text-sm font-medium transition-colors <%= (locals.activeRoute === 'owner-calendar') ? 'bg-primary text-white' : 'text-ink-secondary hover:bg-surface-tint hover:text-ink' %>">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
        <span>Calendar</span>
      </a>

      <a href="/owner/today" class="flex items-center justify-between px-3 py-2.5 rounded-md text-sm font-medium transition-colors <%= (locals.activeRoute === 'owner-today') ? 'bg-primary text-white' : 'text-ink-secondary hover:bg-surface-tint hover:text-ink' %>">
        <div class="flex items-center space-x-3">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span>Today's Operations</span>
        </div>
        <span class="text-xs px-2 py-0.5 rounded-full font-semibold bg-status-warning-tint text-status-warning">• 2 due</span>
      </a>

      <a href="/owner/incidents" class="flex items-center justify-between px-3 py-2.5 rounded-md text-sm font-medium transition-colors <%= (locals.activeRoute === 'owner-incidents') ? 'bg-primary text-white' : 'text-ink-secondary hover:bg-surface-tint hover:text-ink' %>">
        <div class="flex items-center space-x-3">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          <span>Incidents &amp; Deductions</span>
        </div>
        <span class="text-xs px-2 py-0.5 rounded-full font-semibold bg-status-danger text-white">1</span>
      </a>

      <a href="/owner/history" class="flex items-center space-x-3 px-3 py-2.5 rounded-md text-sm font-medium transition-colors <%= (locals.activeRoute === 'owner-history') ? 'bg-primary text-white' : 'text-ink-secondary hover:bg-surface-tint hover:text-ink' %>">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>Custodial History</span>
      </a>

      <a href="/owner/earnings" class="flex items-center space-x-3 px-3 py-2.5 rounded-md text-sm font-medium transition-colors <%= (locals.activeRoute === 'owner-earnings') ? 'bg-primary text-white' : 'text-ink-secondary hover:bg-surface-tint hover:text-ink' %>">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>Earnings &amp; Payouts</span>
      </a>
    </nav>
  </div>

  <!-- Bottom CTA -->
  <div class="pt-6 border-t border-line">
    <% if (locals.ownerVerified !== false) { %>
      <a href="/owner/spaces/add" class="btn-primary w-full text-xs py-2.5 flex items-center justify-center space-x-1">
        <span>+ Add New Space</span>
      </a>
    <% } else { %>
      <button disabled class="w-full text-xs py-2.5 bg-line-subtle text-ink-muted rounded-md cursor-not-allowed">
        Listing Disabled
      </button>
    <% } %>
  </div>
</aside>
