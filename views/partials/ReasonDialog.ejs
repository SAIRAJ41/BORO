<%
  const dId = locals.dialogId || 'reason-modal';
  const postUrl = locals.postUrl || '#';
  const actionTitle = locals.actionTitle || 'Provide Justification';
  const actionLabel = locals.actionLabel || 'Confirm Decision';
  const isDestructive = locals.isDestructive || false;
%>
<div id="<%= dId %>" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-ink/50 backdrop-blur-sm hidden" role="dialog" aria-modal="true" aria-labelledby="<%= dId %>-title">
  <div class="bg-surface border border-line rounded-2xl shadow-2xl max-w-lg w-full overflow-hidden animate-in fade-in zoom-in-95">
    
    <!-- Modal Header -->
    <div class="p-5 border-b border-line flex items-center justify-between bg-surface-tint">
      <div class="flex items-center space-x-2.5">
        <div class="w-8 h-8 rounded-xl bg-primary text-surface flex items-center justify-center text-sm font-bold">
          ✍️
        </div>
        <h3 id="<%= dId %>-title" class="text-base font-bold text-ink"><%= actionTitle %></h3>
      </div>
      <button type="button" onclick="closeReasonDialog('<%= dId %>')" class="p-1 rounded-lg text-ink-muted hover:text-ink focus:ring-2 focus:ring-primary" aria-label="Close dialog">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Modal Form -->
    <form id="<%= dId %>-form" action="<%= postUrl %>" method="POST" class="p-5 space-y-4">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
      <div>
        <label for="<%= dId %>-reason" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          Mandatory Reason / Audit Directive <span class="text-status-danger">*</span>
        </label>
        <p id="<%= dId %>-prompt" class="text-xs text-ink-muted mb-2">
          State the justification for this action. Required for the immutable platform audit ledger.
        </p>
        <textarea
          id="<%= dId %>-reason"
          name="reason"
          rows="4"
          required
          placeholder="Enter a clear explanation..."
          class="input w-full text-xs placeholder:text-ink-muted focus:ring-2 focus:ring-primary"
        ></textarea>
        <p id="<%= dId %>-error" class="text-xs text-status-danger font-semibold mt-1 hidden">
          A reason is required before this action can be submitted.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="pt-4 border-t border-line flex items-center justify-end gap-2">
        <button type="button" onclick="closeReasonDialog('<%= dId %>')" class="btn btn-secondary text-xs py-2 px-3">
          Cancel
        </button>
        <button type="submit" id="<%= dId %>-submit" class="btn btn-primary text-xs py-2 px-4 font-semibold">
          <%= actionLabel %>
        </button>
      </div>
    </form>
  </div>
</div>
