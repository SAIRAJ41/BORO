<div class="space-y-6">
  <!-- Brand Header -->
  <div class="text-center">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-primary text-white font-bold text-xl mb-3 shadow-sm focus:outline-none">
      B
    </div>
    <h1 class="text-2xl font-bold text-ink tracking-tight">Create an account</h1>
    <p class="text-sm text-ink-muted mt-1">Join BORO to share and book local community spaces</p>
  </div>

  <!-- Sign Up Card -->
  <div class="card p-6 sm:p-7 bg-surface-card border border-line shadow-sm rounded-2xl">
    <!-- Inline Error Message Display -->
    <% if (locals.flash && locals.flash.error && locals.flash.error.length > 0) { %>
      <div id="signup-error-message" role="alert" class="p-3 mb-4 rounded-xl bg-status-danger/10 border border-status-danger/30 text-xs text-status-danger flex items-center gap-2">
        <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span><%= locals.flash.error[0] %></span>
      </div>
    <% } %>

    <form action="/signup" method="POST" enctype="multipart/form-data" class="space-y-4" novalidate>
      <!-- BACKEND: wire a real CSRF check -->
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">

      <!-- Full Name -->
      <div>
        <label for="name" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          Full Name
        </label>
        <input
          type="text"
          id="name"
          name="name"
          autocomplete="name"
          required
          aria-required="true"
          placeholder="e.g. Ramesh Chandra"
          class="w-full px-3.5 py-2.5 text-sm bg-surface-tint border border-line rounded-xl text-ink placeholder-ink-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
        />
      </div>

      <!-- Email Address -->
      <div>
        <label for="email" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          Email address
        </label>
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
          aria-required="true"
          placeholder="name@example.com"
          class="w-full px-3.5 py-2.5 text-sm bg-surface-tint border border-line rounded-xl text-ink placeholder-ink-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
        />
      </div>

      <!-- Phone Number -->
      <div>
        <label for="phone" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          Phone Number
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          autocomplete="tel"
          required
          aria-required="true"
          placeholder="+91 98765 43210"
          class="w-full px-3.5 py-2.5 text-sm bg-surface-tint border border-line rounded-xl text-ink placeholder-ink-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
        />
      </div>

      <!-- Role Selector -->
      <div>
        <label for="role" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          I am a
        </label>
        <select
          id="role"
          name="role"
          class="w-full px-3.5 py-2.5 text-sm bg-surface-tint border border-line rounded-xl text-ink focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
          onchange="
            const ownerFields = document.getElementById('owner-additional-fields');
            if (this.value === 'owner') {
              ownerFields.classList.remove('hidden');
            } else {
              ownerFields.classList.add('hidden');
            }
          "
        >
          <option value="user">Community member (Book & use spaces)</option>
          <option value="owner">Space owner (List & manage community spaces)</option>
        </select>
      </div>

      <!-- Conditional Space Owner Fields -->
      <div id="owner-additional-fields" class="hidden space-y-4 p-4 rounded-xl bg-surface-tint/60 border border-line">
        <div>
          <label for="organisation" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
            Organisation / Society Name
          </label>
          <input
            type="text"
            id="organisation"
            name="organisation"
            placeholder="e.g. Navprabhat Cultural Trust"
            class="w-full px-3.5 py-2.5 text-sm bg-white border border-line rounded-xl text-ink placeholder-ink-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
          />
        </div>

        <div>
          <label for="id_proof" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
            Demo ID Proof (Aadhaar / Society Deed / Electricity Bill)
          </label>
          <input
            type="file"
            id="id_proof"
            name="id_proof"
            accept=".pdf,.png,.jpg,.jpeg"
            class="w-full px-3 py-2 text-xs bg-white border border-line rounded-xl text-ink file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-primary file:text-white hover:file:bg-primary-hover cursor-pointer"
          />
        </div>

        <div class="p-3 rounded-lg bg-status-info/10 border border-status-info/20 text-xs text-status-info leading-relaxed">
          <strong>Review Policy:</strong> Owner accounts are reviewed by an admin before listing. You can sign in immediately, but space listing activates upon document review.
        </div>
      </div>

      <!-- Password -->
      <div>
        <label for="password" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          Password
        </label>
        <input
          type="password"
          id="password"
          name="password"
          autocomplete="new-password"
          required
          aria-required="true"
          placeholder="••••••••"
          class="w-full px-3.5 py-2.5 text-sm bg-surface-tint border border-line rounded-xl text-ink placeholder-ink-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
        />
      </div>

      <!-- Confirm Password -->
      <div>
        <label for="confirm_password" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-1.5">
          Confirm Password
        </label>
        <input
          type="password"
          id="confirm_password"
          name="confirm_password"
          autocomplete="new-password"
          required
          aria-required="true"
          placeholder="••••••••"
          class="w-full px-3.5 py-2.5 text-sm bg-surface-tint border border-line rounded-xl text-ink placeholder-ink-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
        />
      </div>

      <p class="text-[11px] text-ink-muted leading-relaxed">
        By registering, you agree to the BORO Community Guidelines, Reliability Score rules, and Space Usage terms.
      </p>

      <!-- Submit Button -->
      <button
        type="submit"
        class="w-full py-2.5 px-4 bg-primary hover:bg-primary-hover text-white text-sm font-semibold rounded-xl shadow-sm transition focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary"
      >
        Create Account
      </button>
    </form>

    <div class="mt-5 pt-4 border-t border-line text-center text-xs text-ink-muted">
      Already have an account?
      <a href="/login" class="text-primary font-semibold hover:underline ml-1">Sign in</a>
    </div>
  </div>
</div>
