<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-ink">Notifications &amp; Alerts</h1>
      <p class="text-sm text-ink-muted">Stay updated on your booking requests, access PIN codes, and score adjustments</p>
    </div>

    <% if (notifications && notifications.length > 0) { %>
      <form action="/notifications/read-all" method="POST">
        <button type="submit" class="btn btn-secondary text-xs">
          Mark All as Read
        </button>
      </form>
    <% } %>
  </div>

  <!-- Notification Filter Chips -->
  <div class="flex gap-2">
    <a href="/notifications?filter=all" 
       class="px-3 py-1.5 rounded-xl text-xs font-semibold <%= filter !== 'unread' ? 'bg-primary text-surface' : 'bg-surface border border-line text-ink-muted' %>">
      All
    </a>
    <a href="/notifications?filter=unread" 
       class="px-3 py-1.5 rounded-xl text-xs font-semibold <%= filter === 'unread' ? 'bg-primary text-surface' : 'bg-surface border border-line text-ink-muted' %>">
      Unread Only
    </a>
  </div>

  <!-- Notification Feed -->
  <% if (notifications && notifications.length > 0) { %>
    <div class="space-y-3">
      <% notifications.forEach(item => { %>
        <%- include('../../partials/NotificationCard', { notification: item, helpers: helpers }) %>
      <% }); %>
    </div>
  <% } else { %>
    <%- include('../../partials/EmptyState', {
      title: 'No notifications',
      description: 'You are all caught up! Booking status updates and time slot notifications will arrive here.',
      actionText: 'Back to Bookings',
      actionUrl: '/my-bookings'
    }) %>
  <% } %>
</div>
