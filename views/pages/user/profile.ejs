<div class="space-y-6">
  <!-- Profile Header -->
  <div class="card p-6 bg-surface border border-line flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <div class="w-16 h-16 rounded-2xl bg-primary text-surface font-black text-2xl flex items-center justify-center shadow-sm">
        <%= helpers.getUserInitials(user.name) %>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-xl font-bold text-ink"><%= user.name %></h1>
          <%- include('../../partials/VerifiedBadge', { verified: user.verified, label: user.role === 'owner' ? (user.verified ? 'Verified Owner Partner' : 'Pending Owner Review') : (user.verified ? 'Verified Resident' : 'Unverified Resident') }) %>
        </div>
        <p class="text-sm text-ink-muted"><%= user.email %> &bull; <%= user.phone || '+91 98765 43210' %></p>
        <div class="mt-1 flex items-center gap-2 text-xs text-ink-muted">
          <span>Member since <%= helpers.formatDate(user.created_at) %></span>
          <span>&bull;</span>
          <span class="capitalize font-medium"><%= user.role %></span>
        </div>
      </div>
    </div>

    <!-- Reliability Score Pill -->
    <div class="p-4 bg-surface-tint border border-line rounded-2xl flex items-center gap-4">
      <div>
        <div class="text-xs uppercase font-medium tracking-wider text-ink-muted">Reliability Score</div>
        <div class="text-2xl font-bold text-ink"><%= user.score %>/120</div>
      </div>
      <%- include('../../partials/ScoreBadge', { score: user.score, showExplanation: false }) %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Verification Details & Document Submission -->
    <div class="md:col-span-2 space-y-6">
      <div class="card p-6 bg-surface border border-line">
        <h2 class="text-base font-semibold text-ink mb-1">
          <%= user.role === 'owner' ? 'Owner Partner Accreditation' : 'Identity & Trust Verification' %>
        </h2>
        <p class="text-xs text-ink-muted mb-4">
          <%= user.role === 'owner'
            ? 'Verified space partners can list and manage community spaces. Accreditation is reviewed by trust administrators.'
            : 'Verified profiles receive faster booking decisions and higher trust among space owners.' %>
        </p>

        <% if (user.role === 'owner') { %>
          <div class="space-y-3 mb-6">
            <div class="flex items-center justify-between p-3 rounded-xl bg-surface-tint border border-line">
              <div class="flex items-center gap-3">
                <span class="<%= user.verified ? 'text-status-success font-bold' : 'text-status-warning font-bold' %>">
                  <%= user.verified ? '✓' : '⏳' %>
                </span>
                <div>
                  <div class="text-sm font-medium text-ink">Owner Accreditation Status</div>
                  <div class="text-xs text-ink-muted"><%= user.verified ? 'Accredited community partner' : 'Administrative identity review in progress' %></div>
                </div>
              </div>
              <span class="badge <%= user.verified ? 'badge-success' : 'badge-warning' %> text-xs">
                <%= user.verified ? 'Verified' : 'Pending' %>
              </span>
            </div>
          </div>

          <form action="/owner/verification-document" method="POST" enctype="multipart/form-data" class="p-4 rounded-xl border border-dashed border-line bg-surface-tint">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <div class="text-xs font-semibold text-ink uppercase tracking-wider mb-2">Submit Owner Verification Document</div>
            <p class="text-xs text-ink-muted mb-3">Upload your government ID or custodian authorization document (PDF, PNG, JPG, max 10 MB).</p>
            <div class="flex flex-wrap items-center gap-3">
              <input type="file" name="id_proof" accept=".pdf,.png,.jpg,.jpeg" required class="text-xs text-ink">
              <button type="submit" class="btn btn-primary text-xs font-semibold">Upload ID Proof</button>
            </div>
          </form>
        <% } else { %>
          <div class="space-y-3 mb-6">
            <div class="flex items-center justify-between p-3 rounded-xl bg-surface-tint border border-line">
              <div class="flex items-center gap-3">
                <span class="text-status-success font-bold">&check;</span>
                <div>
                  <div class="text-sm font-medium text-ink">Government ID Verification</div>
                  <div class="text-xs text-ink-muted">Aadhaar / Voter ID proof on file</div>
                </div>
              </div>
              <span class="badge badge-success text-xs">Verified</span>
            </div>

            <div class="flex items-center justify-between p-3 rounded-xl bg-surface-tint border border-line">
              <div class="flex items-center gap-3">
                <span class="text-status-success font-bold">&check;</span>
                <div>
                  <div class="text-sm font-medium text-ink">Address / Ward Proof</div>
                  <div class="text-xs text-ink-muted">Proof of local ward residency</div>
                </div>
              </div>
              <span class="badge badge-success text-xs">Verified</span>
            </div>
          </div>

          <form action="/profile/verify" method="POST" class="p-4 rounded-xl border border-dashed border-line bg-surface-tint">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <div class="text-xs font-semibold text-ink uppercase tracking-wider mb-2">Resident identity documents</div>
            <p class="text-xs text-ink-muted mb-3">Your resident identity is already active and verified in good standing.</p>
            <div class="flex items-center gap-3">
              <input type="file" class="text-xs text-ink-muted" disabled>
              <button type="submit" class="btn btn-secondary text-xs" disabled>Verified on file</button>
            </div>
          </form>
        <% } %>
      </div>

      <!-- Score History Ledger -->
      <div class="card p-6 bg-surface border border-line">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base font-semibold text-ink">Recent Score Adjustments</h2>
          <a href="/my-score" class="text-xs text-primary font-medium hover:underline">Full Score Breakdown &rarr;</a>
        </div>

        <% if (scoreEvents && scoreEvents.length > 0) { %>
          <div class="divide-y divide-line">
            <% scoreEvents.forEach(evt => { %>
              <div class="py-3 flex items-center justify-between">
                <div>
                  <div class="text-sm font-medium text-ink"><%= evt.reason %></div>
                  <div class="text-xs text-ink-muted"><%= helpers.formatDate(evt.created_at) %></div>
                </div>
                <div class="font-bold text-sm <%= evt.delta > 0 ? 'text-status-success' : 'text-status-danger' %>">
                  <%= evt.delta > 0 ? '+' + evt.delta : evt.delta %> pts
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-xs text-ink-muted">No score adjustments recorded yet.</p>
        <% } %>
      </div>
    </div>

    <!-- Quick Stats & Usage Rules -->
    <div class="space-y-6">
      <div class="card p-5 bg-surface border border-line">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-muted mb-4">Account Usage</h3>
        <div class="space-y-3">
          <div class="flex justify-between items-center text-sm">
            <span class="text-ink-muted">Active Bookings:</span>
            <span class="font-semibold text-ink"><%= activeBookingsCount %> / 2 (max allowed)</span>
          </div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-ink-muted">Total Completed:</span>
            <span class="font-semibold text-ink"><%= totalBookingsCount %> bookings</span>
          </div>
          <div class="flex justify-between items-center text-sm">
            <span class="text-ink-muted">Account Status:</span>
            <span class="badge badge-success text-xs">Active &bull; In Good Standing</span>
          </div>
        </div>
      </div>

      <div class="card p-5 bg-surface-tint border border-line">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">Community Trust Guarantee</h3>
        <p class="text-xs text-ink-muted leading-relaxed">
          BORO rewards responsible use. Returning community halls, grounds, and rooms clean and on time adds +5 to your score each booking.
        </p>
      </div>
    </div>
  </div>
</div>
