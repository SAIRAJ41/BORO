<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-ink">Owner Verification Queue</h1>
      <p class="text-sm text-ink-muted">Inspect identity documents before space owners can complete listing review</p>
    </div>
    <div class="text-xs text-ink-muted bg-surface px-3 py-1.5 rounded-xl border border-line">
      Pending Reviews: <span class="font-bold text-status-warning"><%= pendingOwners.length %></span>
    </div>
  </div>

  <% if (pendingOwners && pendingOwners.length > 0) { %>
    <div class="space-y-4">
      <% pendingOwners.forEach(owner => { %>
        <div class="card p-6 bg-surface border border-line shadow-sm space-y-4">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 pb-4 border-b border-line">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-full bg-status-warning/15 text-status-warning font-bold flex items-center justify-center text-sm">
                <%= helpers.getUserInitials(owner.name) %>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h2 class="text-base font-bold text-ink"><%= owner.name %></h2>
                  <span class="badge badge-warning text-xs">Pending Verification</span>
                </div>
                <p class="text-xs text-ink-muted mt-0.5"><%= owner.email %><%= owner.phone ? ' • ' + owner.phone : '' %></p>
              </div>
            </div>

            <div class="text-xs text-ink-muted">
              Submitted: <%= helpers.formatDate(owner.applied_at || owner.created_at) %>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 p-3.5 rounded-xl bg-surface-tint border border-line text-xs">
            <div>
              <span class="text-ink-muted uppercase tracking-wider text-[10px]">Organisation</span>
              <div class="font-medium text-ink mt-0.5"><%= owner.organisation || 'Not provided' %></div>
            </div>
            <div>
              <span class="text-ink-muted uppercase tracking-wider text-[10px]">Identity document</span>
              <div class="font-medium text-ink mt-0.5">
                <% if (owner.document_available) { %>
                  Available<%= owner.document_type ? ' (' + owner.document_type + ')' : '' %>
                <% } else { %>
                  Missing
                <% } %>
              </div>
            </div>
            <div>
              <span class="text-ink-muted uppercase tracking-wider text-[10px]">Proposed Spaces</span>
              <div class="font-bold text-ink mt-0.5"><%= owner.spaces_proposed || 0 %></div>
            </div>
          </div>

          <div class="flex justify-end gap-2 pt-2">
            <button onclick="window.openReasonDialog('/admin/owners/<%= owner.id %>/reject', 'Reject Owner Verification', 'Mandatory: Enter the reason for rejection so the applicant can submit corrected documents.')"
                    class="btn btn-secondary text-xs text-status-danger border-status-danger/30 hover:bg-status-danger/10">
              Reject
            </button>

            <% if (owner.document_available) { %>
              <a href="/admin/owners/<%= owner.id %>/document" target="_blank" rel="noopener" class="btn btn-secondary text-xs">
                Open Secure Document
              </a>
            <% } %>

            <form action="/admin/owners/<%= owner.id %>/verify" method="POST">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
              <button type="submit" class="btn btn-primary text-xs font-bold" <%= owner.document_available ? '' : 'disabled' %>>
                Approve Verification
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <%- include('../../partials/EmptyState', {
      title: 'No pending owner verifications',
      description: 'All space owner applications have been reviewed and verified.',
      actionText: 'Back to Overview',
      actionUrl: '/admin/overview'
    }) %>
  <% } %>
</div>
