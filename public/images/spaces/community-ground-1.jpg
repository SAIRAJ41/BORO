<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="sky" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#4a6984" />
      <stop offset="100%" stop-color="#8ba3b8" />
    </linearGradient>
    <linearGradient id="grass" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#3d6b4f" />
      <stop offset="100%" stop-color="#2b4c38" />
    </linearGradient>
  </defs>
  <rect width="800" height="260" fill="url(#sky)"/>
  <rect y="260" width="800" height="240" fill="url(#grass)"/>
  <!-- Pitch line -->
  <ellipse cx="400" cy="380" rx="220" ry="80" fill="#4d7e5d" opacity="0.6"/>
  <!-- Goal posts -->
  <line x1="320" y1="230" x2="320" y2="280" stroke="#ffffff" stroke-width="4"/>
  <line x1="480" y1="230" x2="480" y2="280" stroke="#ffffff" stroke-width="4"/>
  <line x1="320" y1="230" x2="480" y2="230" stroke="#ffffff" stroke-width="4"/>
  <text x="400" y="160" font-family="Inter, sans-serif" font-size="28" font-weight="600" fill="#ffffff" text-anchor="middle" letter-spacing="1">COMMUNITY SPORTS GROUND</text>
  <text x="400" y="195" font-family="Inter, sans-serif" font-size="14" font-weight="400" fill="#e2e8f0" text-anchor="middle">Floodlit Outfield • Turf Pitch • Boundary Wall &amp; Gates</text>
</svg>
