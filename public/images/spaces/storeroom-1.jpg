<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="storeBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2d3748" />
      <stop offset="100%" stop-color="#1a202c" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#storeBg)"/>
  <!-- Shelving Units -->
  <rect x="120" y="80" width="180" height="360" fill="none" stroke="#718096" stroke-width="4"/>
  <line x1="120" y1="170" x2="300" y2="170" stroke="#718096" stroke-width="3"/>
  <line x1="120" y1="260" x2="300" y2="260" stroke="#718096" stroke-width="3"/>
  <line x1="120" y1="350" x2="300" y2="350" stroke="#718096" stroke-width="3"/>

  <rect x="500" y="80" width="180" height="360" fill="none" stroke="#718096" stroke-width="4"/>
  <line x1="500" y1="170" x2="680" y2="170" stroke="#718096" stroke-width="3"/>
  <line x1="500" y1="260" x2="680" y2="260" stroke="#718096" stroke-width="3"/>
  <line x1="500" y1="350" x2="680" y2="350" stroke="#718096" stroke-width="3"/>

  <!-- Secure Padlock Symbol in center -->
  <rect x="360" y="240" width="80" height="60" rx="8" fill="#e2e8f0"/>
  <path d="M 375 240 L 375 210 Q 400 180 425 210 L 425 240" fill="none" stroke="#e2e8f0" stroke-width="8"/>
  <circle cx="400" cy="270" r="6" fill="#1a202c"/>

  <text x="400" y="360" font-family="Inter, sans-serif" font-size="24" font-weight="600" fill="#ffffff" text-anchor="middle" letter-spacing="1">SECURE COMMUNITY STOREROOM</text>
  <text x="400" y="395" font-family="Inter, sans-serif" font-size="13" font-weight="400" fill="#94a3b8" text-anchor="middle">Heavy-Duty Shelves • Dual Padlock Security • Dry Storage</text>
</svg>
