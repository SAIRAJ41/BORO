<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2c3e50" />
      <stop offset="100%" stop-color="#1a252f" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#bg)"/>
  <!-- Hall Arches & Columns -->
  <path d="M 100 500 L 100 220 Q 150 160 200 220 L 200 500 Z" fill="#34495e" opacity="0.6"/>
  <path d="M 250 500 L 250 180 Q 320 110 390 180 L 390 500 Z" fill="#3d566e" opacity="0.8"/>
  <path d="M 410 500 L 410 180 Q 480 110 550 180 L 550 500 Z" fill="#3d566e" opacity="0.8"/>
  <path d="M 600 500 L 600 220 Q 650 160 700 220 L 700 500 Z" fill="#34495e" opacity="0.6"/>
  <!-- Floor line -->
  <rect x="0" y="440" width="800" height="60" fill="#243342"/>
  <!-- Warm Stage Light -->
  <circle cx="400" cy="120" r="140" fill="#f39c12" opacity="0.15"/>
  <text x="400" y="270" font-family="Inter, sans-serif" font-size="28" font-weight="600" fill="#ffffff" text-anchor="middle" letter-spacing="1">COMMUNITY HALL</text>
  <text x="400" y="305" font-family="Inter, sans-serif" font-size="14" font-weight="400" fill="#cbd5e1" text-anchor="middle">Acoustic Ceiling • Polished Parquet Flooring • Stage Lighting</text>
</svg>
