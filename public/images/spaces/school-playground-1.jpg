<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="sky2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#3b5998" />
      <stop offset="100%" stop-color="#6d84b4" />
    </linearGradient>
    <linearGradient id="track" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#b0523e" />
      <stop offset="100%" stop-color="#8a3c2c" />
    </linearGradient>
  </defs>
  <rect width="800" height="280" fill="url(#sky2)"/>
  <rect y="280" width="800" height="220" fill="url(#track)"/>
  <!-- Track lines -->
  <ellipse cx="400" cy="400" rx="300" ry="90" fill="none" stroke="#ffffff" stroke-width="3" stroke-dasharray="12,8" opacity="0.7"/>
  <ellipse cx="400" cy="400" rx="240" ry="70" fill="#4a7c59" opacity="0.8"/>
  <text x="400" y="160" font-family="Inter, sans-serif" font-size="28" font-weight="600" fill="#ffffff" text-anchor="middle" letter-spacing="1">SCHOOL PLAYGROUND</text>
  <text x="400" y="195" font-family="Inter, sans-serif" font-size="14" font-weight="400" fill="#e2e8f0" text-anchor="middle">After-Hours Access • 200m Running Track • Multi-Sport Court</text>
</svg>
